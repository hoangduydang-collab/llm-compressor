---
# GLM-5.2 distributed PTQ on the Rancher infermesh-test cluster.
#
# TEMPLATE — do not `kubectl apply` this directly. Render and launch with:
#     pipeline/k8s/launch-quant-glm52.sh --method gptq --gpus 4
# The launcher fills in the placeholders, gates on real free GPU capacity, pins
# the code to a pushed commit, and refuses to launch if any placeholder is left
# unsubstituted.
#
# WORLD SIZE IS A PARAMETER, deliberately. The retired srun launcher
# (pipeline/slurm/run_m3_distributed_quant_smoke_srun.sh) hardcoded
# --nproc_per_node=8, and pipeline/tests/test_m3_distributed_quant_smoke.py
# asserts that literal string. That cluster is gone, and on Rancher we cannot get
# 8 GPUs on one node today (measured: largest free node = 6). Any evidence gate
# copied from the M3 handoffs that asserts `world_sizes == {8}` must be
# parameterized before reuse or it will fail-closed on a legitimate 4-GPU run.
#
# Why 4 GPUs costs speed but not correctness: docs/guides/big_models_and_
# distributed/distributed_oneshot.md — each rank takes a disjoint N/R partition
# and "modifiers then synchronize statistics across ranks so all ranks produce
# identical quantization parameters". partition_bounds (pipeline/calibration.py:34)
# uses floor division, so N need not divide R; the only requirement is N >= R so
# no rank starves.
#
# Peak Hessian memory does NOT scale down with rank count. Every rank accumulates
# Hessians for ALL targeted modules in the current layer (gptq/base.py:277); only
# at compression time does _reduce_hessian_to_target_rank (:337) reduce to the
# owner and free non-owners (:360). For GLM-5.2 (hidden 6144, moe_intermediate
# 2048, 256 routed experts) that is ~76 GiB of fp32 Hessian per rank for one MoE
# layer, plus ~18 GiB of layer weights. If it OOMs, the lever is
# offload_hessians=True (modifiers/gptq/base.py:126) — NOT more GPUs.
apiVersion: batch/v1
kind: Job
metadata:
  name: quant-glm52-@@METHOD@@-@@RUN_TAG@@
  namespace: evaluation
  labels:
    owner: hoangduy.dang
    purpose: distributed-ptq
    model: glm-5-2
    method: "@@METHOD@@"
spec:
  backoffLimit: 0            # never silently retry a multi-hour GPU run
  activeDeadlineSeconds: 172800
  ttlSecondsAfterFinished: 86400
  template:
    metadata:
      labels:
        owner: hoangduy.dang
        purpose: distributed-ptq
        method: "@@METHOD@@"
    spec:
      restartPolicy: Never
      # GPU nodes are tainted nvidia.com/gpu=present:NoSchedule.
      #
      # By DEFAULT there is no nodeSelector, and that default is deliberate: the
      # scheduler is the only authority that sees true cluster-wide allocation
      # (our token cannot list pods at cluster scope, and Rancher's accounting has
      # been observed OVER-reporting used GPUs -- see RANCHER_GPU_ACCESS.md).
      # Pinning trades that away for placement certainty, so `--node` is opt-in.
      #
      # Pin only when the node matters: taking over a node we are deliberately
      # holding, or sitting next to data staged on its local disk. A pinned pod
      # whose node is full sits Pending forever rather than running elsewhere.
      @@NODESELECTOR@@
      tolerations:
        - {key: nvidia.com/gpu, operator: Exists, effect: NoSchedule}
      containers:
        - name: quantize
          image: lmsysorg/sglang:v0.5.17   # already pulled on these nodes
          imagePullPolicy: IfNotPresent
          env:
            - {name: METHOD, value: "@@METHOD@@"}
            - {name: CONFIG, value: "@@CONFIG@@"}
            - {name: GPUS, value: "@@GPUS@@"}
            # "1" skips the checkpoint save -- see the torchrun line below.
            - {name: EVIDENCE_ONLY, value: "@@EVIDENCE_ONLY@@"}
            # Empty = off. If set to N, build a depth-truncated copy of the model
            # (decoder layers [0,N)) on node-local NVMe and quantize THAT instead
            # of the cephfs snapshot. For calibration-timing probes only: it cuts
            # ~63 min of setup to under a minute, and it is faithful for per-layer
            # cost because layer L's calibration inputs come from layers 0..L-1.
            # Never for a production checkpoint -- the result is not a usable model.
            - {name: SUBSET_LAYERS, value: "@@SUBSET_LAYERS@@"}
            # Block until a still-downloading source snapshot is complete AND
            # verified before doing anything. Empty = start immediately. See the
            # WAIT_FOR_REPO block in the script below.
            - {name: WAIT_FOR_REPO, value: "@@WAIT_FOR_REPO@@"}
            - {name: WAIT_FOR_SHARDS, value: "@@WAIT_FOR_SHARDS@@"}
            - {name: WAIT_TIMEOUT, value: "@@WAIT_TIMEOUT@@"}
            - {name: REPO_URL, value: "https://github.com/hoangduydang-collab/llm-compressor.git"}
            - {name: REPO_REF, value: "@@REPO_REF@@"}
            # Point every HF cache at the CA-region PVC: the BF16 snapshot is
            # already there, and the calibration dataset is then downloaded once
            # and shared by both arms instead of twice over a congested link.
            - {name: HF_HOME, value: "/mnt/cephfs/.hf-cache"}
            - {name: HF_HUB_CACHE, value: "/mnt/cephfs/.hf-cache"}
            - {name: HF_DATASETS_CACHE, value: "/mnt/cephfs/.hf-cache/datasets"}
            - {name: TOKENIZERS_PARALLELISM, value: "false"}
            # Surface real tracebacks instead of a bare C++ abort (M3 lesson:
            # FlashInfer JIT failures printed no Python stack without this).
            - {name: PYTHONFAULTHANDLER, value: "1"}
            - {name: PYTHONUNBUFFERED, value: "1"}
          command: ["bash", "-lc"]
          args:
            - |
              set -euo pipefail
              echo "==> GLM-5.2 $METHOD  world_size=$GPUS  ref=$REPO_REF"
              nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader

              test "$(nvidia-smi -L | wc -l)" -eq "$GPUS" \
                || { echo "ABORT: pod sees $(nvidia-smi -L | wc -l) GPUs, expected $GPUS" >&2; exit 1; }

              # --- code: pinned clone into node-local scratch --------------
              # Not onto the shared PVC: two arms run concurrently and would race
              # on the same tree, and quantization code has no business being
              # written to a volume other people read models from.
              git clone --quiet --filter=blob:none "$REPO_URL" /work/repo
              cd /work/repo
              git checkout --quiet "$REPO_REF"
              echo "==> code at $(git rev-parse --short HEAD)"

              # --- pin the stack to the M3 quantization environment ---------
              # The image ships transformers 5.12.1; MiniMax-M3 was quantized and
              # validated on 5.14.1 (envs/m3-quant-freeze.txt, frozen 2026-07-31,
              # Python 3.12.13). Quantizing GLM-5.2 on a different stack would
              # confound the GLM-vs-M3 comparison on exactly the axis the M3
              # record has a "Transformers 5.14.1 upgrade assessment" section
              # about, so the manifest's semantic pins are installed over the
              # image.
              #
              # torch / triton / nvidia-* / flashinfer are DELIBERATELY left as
              # the image provides them: the image already carries torch 2.11.0,
              # which is the manifest's pin, but as a working CUDA build. Pulling
              # the PyPI wheel over it risks swapping in a different CUDA variant
              # for no semantic gain. Everything that affects quantization
              # numerics is pinned below.
              echo "==> pinning stack to the M3 manifest"
              python - envs/m3-quant-freeze.txt <<'PINS' > /tmp/pins.txt
              import sys, re
              KEEP = re.compile(
                  r"^(transformers|compressed-tensors|accelerate|tokenizers|"
                  r"safetensors|datasets|huggingface_hub|numpy|pydantic|"
                  r"loguru|pyyaml|tqdm|regex|sentencepiece)==",
                  re.IGNORECASE,
              )
              for line in open(sys.argv[1], encoding="utf-8"):
                  s = line.strip()
                  if s and not s.startswith("#") and KEEP.match(s):
                      print(s)
              PINS
              echo "    pinning:"; sed 's/^/      /' /tmp/pins.txt
              pip install --quiet -r /tmp/pins.txt 2>&1 | tail -5

              # The M3 venv carried an in-place repair to transformers'
              # sharded offloaded save_pretrained that no pip freeze can
              # record, so pinning the version silently dropped it and the
              # offloaded-save gate failed this job 3 minutes in. Re-apply it
              # from source control instead of by hand. Fail-closed: a
              # non-zero exit here aborts the run under `set -e`, which is
              # correct -- an unpatched save dies at the end of shard 1 after
              # the whole calibration has been paid for.
              echo "==> hotfix: transformers sharded offloaded save"
              python envs/hotfix-transformers-sharded-save.py --no-backup

              pip install --quiet -e . 2>&1 | tail -2 || true
              python - <<'VER'
              import torch, transformers, llmcompressor
              import importlib.metadata as md
              print(f"==> llmcompressor {llmcompressor.__version__}")
              print(f"==> transformers  {transformers.__version__} (M3: 5.14.1)")
              print(f"==> torch         {torch.__version__} (M3 manifest: 2.11.0)")
              for p in ("compressed-tensors", "accelerate", "huggingface_hub"):
                  try:
                      print(f"==> {p:18s} {md.version(p)}")
                  except md.PackageNotFoundError:
                      print(f"==> {p:18s} MISSING")
              assert transformers.__version__.startswith("5.14"), (
                  f"stack pinning failed: transformers is {transformers.__version__}, "
                  "expected 5.14.x to match the M3 environment"
              )
              VER

              # --- GATE 1: pre-quantization compatibility, CPU-only ---------
              # Enforced here rather than trusted to the operator, because this is
              # the gate the M3 record says must precede every long calibration
              # run. It builds a meta model, mirrors MoE linearization, and runs
              # the real target matching + AWQ mapping resolver. No GPU, no
              # weights, no calibration data. Exit 2 = incompatible.
              mkdir -p /mnt/cephfs/hoangduy/preflight
              REPORT="/mnt/cephfs/hoangduy/preflight/glm52-${METHOD}-@@RUN_TAG@@.json"
              echo "==> gate 1: prequant_compatibility"
              python -m pipeline.prequant_compatibility \
                --config "$CONFIG" --output "$REPORT" \
                || { echo "ABORT: pre-quantization gate FAILED; report at $REPORT" >&2
                     python -c "import json;r=json.load(open('$REPORT'));print(json.dumps(r.get('failures',r),indent=2)[:4000])" 2>/dev/null || true
                     exit 1; }
              echo "==> gate 1 PASSED"

              # --- distributed quantization --------------------------------
              # One process per GPU, single node. Not an Indexed Job: this is
              # data-parallel calibration within one node, so it needs no
              # rendezvous service.
              # --evidence-only skips the checkpoint save. What that saves:
              # a layer-restricted smoke still writes the WHOLE model, because
              # unquantized layers are copied verbatim into the new checkpoint.
              # Measured on run 20260828t070917z (2 of 78 layers targeted):
              # ~1457 GB across 29 shards at ~106 MB/s of cephfs write = ~3.8 h,
              # against ~20 min of actual compression. Read-back was only 0.9 GB,
              # so this is purely write cost; the 16-thread save-prewarm already
              # handles the read side.
              #
              # EVIDENCE_ONLY=1 for iteration smokes that only need calibration
              # mechanics (mapping resolution, scale application, layer selection,
              # timings). Use 0 when the checkpoint is the deliverable, or when the
              # SAVE PATH itself is under test -- three GLM-5.2 runs died inside
              # save_pretrained before producing a single shard, so a green
              # calibration proves nothing about it.
              EVIDENCE_FLAG=""
              if [ "${EVIDENCE_ONLY:-0}" = "1" ]; then
                EVIDENCE_FLAG="--evidence-only"
                echo "==> EVIDENCE_ONLY=1: calibration only, NO checkpoint saved"
              fi

              # --- optional wait for a source snapshot still downloading -------
              #
              # Lets the job be submitted BEFORE its weights exist. It then holds
              # its GPUs and blocks here until the snapshot is complete and
              # verified, so the launch survives the operator's laptop being
              # closed: it is a Kubernetes Job, not a process on a workstation.
              #
              # This replaces waiting outside the cluster and then launching. It is
              # also strictly better than holding the node with an idle sleep pod,
              # which is what it took over from -- same GPUs reserved, except these
              # ones start working the moment the data lands.
              #
              # It verifies rather than merely counting files, because the failure
              # this guards against has already happened once: 64 GB of the GLM-5.3
              # FP8 release was downloaded before anyone noticed it was the wrong
              # artifact. The FP8 release has 141 shards and carries a
              # quantization_config; the BF16 release has 282 and carries none. AWQ
              # cannot consume block-scaled FP8 at all -- llm-compressor has no
              # weight_scale_inv read path anywhere in src/.
              #
              # On timeout it EXITS NONZERO rather than proceeding or idling, so a
              # download that never finishes releases the GPUs instead of holding
              # 8 H100s indefinitely.
              if [ -n "${WAIT_FOR_REPO:-}" ]; then
                WAIT_SHARDS="${WAIT_FOR_SHARDS:-0}"
                WAIT_TIMEOUT="${WAIT_TIMEOUT:-21600}"
                WAIT_POLL="${WAIT_POLL:-60}"
                CACHE="/mnt/cephfs/.hf-cache/${WAIT_FOR_REPO}"
                echo "==> waiting for ${WAIT_FOR_REPO}: ${WAIT_SHARDS} shards, no"
                echo "    quantization_config, timeout ${WAIT_TIMEOUT}s"
                waited=0
                while :; do
                  SNAP=$(ls -d "$CACHE"/snapshots/* 2>/dev/null | head -1)
                  if [ -n "$SNAP" ]; then
                    n=$(ls -1 "$SNAP"/*.safetensors 2>/dev/null | wc -l)
                    inc=$(ls -1 "$CACHE"/blobs/*.incomplete 2>/dev/null | wc -l)
                    if [ "$n" -eq "$WAIT_SHARDS" ] && [ "$inc" -eq 0 ]; then
                      # Fail-closed artifact identity check: a wrong-but-COMPLETE
                      # download must abort, not proceed. A module rather than an
                      # inline heredoc because a heredoc terminator has to sit at
                      # column 0, which is impossible inside a YAML block scalar --
                      # gate 0 caught that as "syntax error: unexpected end of
                      # file" before anything ran.
                      if ! python -m pipeline.verify_source_snapshot "$SNAP" \
                          --require-unquantized --expect-layers 78 \
                          --expect-arch GlmMoeDsaForCausalLM; then
                        echo "ABORT: source artifact failed verification" >&2
                        exit 1
                      fi
                      echo "==> ${WAIT_FOR_REPO} ready after ${waited}s ($n shards)"
                      break
                    fi
                    echo "    ${waited}s: $n/${WAIT_SHARDS} shards, $inc incomplete"
                  else
                    echo "    ${waited}s: no snapshot directory yet"
                  fi
                  if [ "$waited" -ge "$WAIT_TIMEOUT" ]; then
                    echo "ABORT: ${WAIT_FOR_REPO} not ready within ${WAIT_TIMEOUT}s;" >&2
                    echo "       exiting so the GPUs are released" >&2
                    exit 1
                  fi
                  sleep "$WAIT_POLL"
                  waited=$((waited + WAIT_POLL))
                done
              fi

              # --- optional depth-truncated subset on node-local NVMe ---------
              MODEL_OVERRIDE=""
              if [ -n "${SUBSET_LAYERS:-}" ]; then
                if [ "${EVIDENCE_ONLY:-0}" != "1" ]; then
                  # Downgraded from an abort on purpose. The original reasoning was
                  # that saving a subset checkpoint yields "a corrupt artifact that
                  # looks like a real quantization" -- but it does not look real:
                  # build_subset_checkpoint stamps config.json with
                  # _subset_num_layers and _subset_warning, so the artifact
                  # self-labels. Meanwhile blocking the save also blocked the
                  # cheapest way to AUDIT a numerics fix (a ~24 GiB checkpoint that
                  # m3_checkpoint_scale_audit can read in minutes), which is
                  # precisely how the uncompensated-router defect would have been
                  # caught before it shipped. A fail-closed gate that blocks
                  # verification of the bug class it guards against is the wrong
                  # trade.
                  echo "WARNING: saving a SUBSET checkpoint (${SUBSET_LAYERS} layers)." >&2
                  echo "         Valid for fold/numerics audits ONLY. It is not a" >&2
                  echo "         usable model -- never serve or evaluate it." >&2
                fi
                SNAP=$(ls -d /mnt/cephfs/.hf-cache/models--zai-org--GLM-5.2/snapshots/* | head -1)
                [ -n "$SNAP" ] || { echo "ABORT: no GLM-5.2 snapshot in the HF cache" >&2; exit 1; }
                echo "==> building layers-0..$((SUBSET_LAYERS-1)) subset on local NVMe"
                df -hT /scratch | tail -1
                time python -m pipeline.build_subset_checkpoint \
                  --snapshot "$SNAP" --out /scratch/glm52-subset \
                  --layers "$SUBSET_LAYERS"
                du -sh /scratch/glm52-subset
                MODEL_OVERRIDE="--set model.id=/scratch/glm52-subset"
              fi
              echo "==> launching torchrun --nproc_per_node=$GPUS"
              torchrun --nproc_per_node="$GPUS" -m pipeline.run \
                --config "$CONFIG" --stage quantize \
                --set "quantization.method=$METHOD" \
                $MODEL_OVERRIDE \
                $EVIDENCE_FLAG

              echo DONE
          resources:
            requests:
              nvidia.com/gpu: @@GPUS@@
              cpu: "16"
              # Sized to hold the model in RAM instead of streaming it from the
              # cephfs PVC, which measured 31 MB/s single-stream and dominated
              # wall clock (86 min to propagate 35 layers that are not even
              # quantized). The dshm tmpfs below is charged to this container as
              # it fills, so the limit must cover the CPU offload budget plus
              # every rank's working set. M3 measured 600-850 GiB RSS.
              #
              # 1700Gi of the node's 2016 GiB is deliberate and assumes the run
              # OWNS the node: an 8-GPU request already takes every GPU, and
              # this was launched with explicit permission for a full node. A
              # 4-GPU run on a shared node should lower this back down --
              # otherwise it starves whatever else lands there.
              memory: "700Gi"
              ephemeral-storage: "80Gi"
            limits:
              nvidia.com/gpu: @@GPUS@@
              cpu: "48"
              memory: "1700Gi"
              ephemeral-storage: "150Gi"
          securityContext:
            capabilities:
              add: ["IPC_LOCK"]     # pinned host memory for NCCL
          volumeMounts:
            - {name: model-cache, mountPath: /mnt/cephfs}
            - {name: dshm, mountPath: /dev/shm}
            - {name: work, mountPath: /work}
            - {name: tmp, mountPath: /tmp}
            - {name: scratch, mountPath: /scratch}
      volumes:
        - name: model-cache
          persistentVolumeClaim:
            claimName: model-cache-shared
        # Node-local NVMe, for SUBSET_LAYERS runs. Measured on gpu04 (2026-08-28):
        # /dev/nvme1n1p2, ext4, rotational=0, 642 GB free of 879 GB, and
        #   read  1632 MB/s @1 reader ... 1723 MB/s @16 readers (flat)
        #   write 921 MB/s
        # against cephfs's 31 MB/s single-stream / 135-260 MB/s across 8 readers.
        # The device saturates at ONE reader, so unlike cephfs there is nothing to
        # gain from read concurrency here.
        #
        # Sized well below the free space on purpose: emptyDir lands on the node's
        # kubelet filesystem, and filling it triggers node-level DiskPressure
        # eviction that would hit OTHER tenants' pods, not just this job. 80Gi
        # holds the 24.2 GiB layers-0..3 subset with room for offload, and the
        # whole 1403 GiB model does NOT fit here in any case.
        - name: scratch
          emptyDir:
            sizeLimit: 80Gi
        # benchmark-datasets is DELIBERATELY not mounted: it is
        # sc-file-nfs-vast-my (my-region), and the nfs.csi.k8s.io driver is not
        # registered on the CA nodes — mounting it fails with
        # "driver name nfs.csi.k8s.io not found". Calibration data comes from the
        # HF cache on cephfs instead. k8s/gpu-devbox.yaml still mounts it and
        # will not schedule on a CA GPU node for this reason.
        - name: dshm
          emptyDir:
            medium: Memory
            # The 64Mi default breaks NCCL and dataloaders. Beyond that, this is
            # the REAL ceiling on distributed CPU offload: compressed-tensors
            # puts one shm segment per offloaded tensor in /dev/shm, so
            # model.max_memory.cpu cannot exceed this no matter what the config
            # says. At 64Gi, GLM-5.2 kept ~1133 GB of its 1485 GB on cephfs --
            # measured at 31 MB/s single-stream, which dominated wall clock
            # (86 min just to propagate layers 7-41, vs ~4 min to compress one).
            #
            # tmpfs is charged to the container's memory limit as it fills, so
            # this does NOT reserve anything up front and adds no node pressure
            # beyond the existing limit below. Sized to leave room for four
            # ranks' working set (M3 measured 600-850 GiB RSS).
            #
            # vm.max_map_count is NOT the binding constraint for GLM-5.2:
            # even full CPU residency projects ~176k segments against the
            # 262144 limit. The VMA gate in pipeline/quantize.py verifies this
            # per run -- do not raise this without letting that gate pass.
            #
            # This is a CEILING shared by both arms, not a per-arm setting. The
            # arm's actual shm consumption is model.max_memory.cpu, currently
            # 900e9 (838 GiB) for both. Raising either above ~1011 GB is blocked
            # on an unmeasured quantity -- whether from_accelerate turns the
            # model's mmap views into real tmpfs pages -- and for GPTQ it is
            # blocked outright by 608 GiB of offloaded Hessians (see that
            # config's max_memory block). Kept at 900Gi to stay coherent with
            # the validated budget; raise both together, never this alone.
            #
            # Do not read this as "the model is fully resident". GPUs contribute
            # ZERO residency: compressed_tensors intercepts
            # device_map="auto_offload" as "same as auto, but only cpu/disk are
            # visible", so accelerate never places a weight on an accelerator
            # (measured in situ, run 20260828t052128z: 1509 MiB per GPU, bare
            # CUDA context, for the whole load). An earlier version of this
            # comment claimed 640 GB VRAM + 900 GB CPU = 1540 GB > 1485 GB and
            # therefore no spill; that was wrong.
            sizeLimit: 900Gi
        - name: work
          emptyDir:
            sizeLimit: 100Gi
        - name: tmp
          emptyDir:
            sizeLimit: 50Gi
